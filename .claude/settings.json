{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(cat *.env*)",
      "Bash(cat .env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(cat .env*)",
      "PowerShell(type .env*)",
      "PowerShell(Get-ChildItem Env:*)",
      "PowerShell(dir env:*)"
    ]
  }
}
